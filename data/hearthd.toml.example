# /etc/hearth/hearthd.toml — rules for hearthd (moves to the parent app in M5).
# Admin accounts (sudo/wheel/admin group, or any sudo rights) are always ignored.
# ntfy server for the parent's phone (self-hosted or https://ntfy.sh). Pair with: sudo hearthd pair
# relay = "https://ntfy.example.org"
grace_seconds = 60   # lock -> logout delay once a limit applies

[[child]]
user = "alice"
daily_minutes = 120
allowed = "07:00-20:00"   # same-day window; omit for any time

# Optional per-day overrides (mon..sun); unset fields fall back to the above.
[child.weekday.sat]
daily_minutes = 180
allowed = "08:00-21:00"

[child.weekday.sun]
daily_minutes = 180

# Daily minutes per app (desktop file ID without ".desktop"); 0 = blocked.
# Snaps use <snap>_<app>, e.g. firefox_firefox. Counts "time open" while the
# child is active; at the limit the app is closed (SIGTERM, then killed after 10 s).
[child.apps]
"org.kde.konsole" = 30
"firefox_firefox" = 60

# DNS filtering (omit for none). Blocks each domain and its subdomains, forces
# SafeSearch on Google, YouTube (moderate), Bing and DuckDuckGo, and turns off
# Firefox's own DNS-over-HTTPS. DNS-over-TLS (port 853) is rejected.
[child.web]
block = ["tiktok.com", "example-casino.com"]
safesearch = true
