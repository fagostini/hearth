<?xml version="1.0" encoding="utf-8"?>
<!-- Notification icon: the app icon (screen with a time ring) as a silhouette; Android tints it.
     Drawn on the app icon's 108-unit grid, cropped to its middle 72 units. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="72"
    android:viewportHeight="72">
    <group android:translateX="-18" android:translateY="-18">
        <!-- screen and stand -->
        <path
            android:pathData="M29,26 H79 A8,8 0 0 1 87,34 V64 A8,8 0 0 1 79,72 H29 A8,8 0 0 1 21,64 V34 A8,8 0 0 1 29,26 Z M54,72 V81 M43,82 H65"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- time ring, two thirds used -->
        <path
            android:pathData="M54,36 A13,13 0 1 1 42.4,54.9"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="6"
            android:strokeLineCap="round" />
        <!-- hands -->
        <path
            android:pathData="M54,49 V42 M54,49 L59,51.9"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="4.5"
            android:strokeLineCap="round" />
    </group>
